# Verplicht
DATABASE_URL=            # door Railway gezet via de Postgres-plugin: ${{Postgres.DATABASE_URL}}
ADMIN_PASSWORD=          # wachtwoord voor /admin
SESSION_SECRET=          # lange willekeurige string
NODE_ENV=production
BASE_URL=https://boekpouwvervoer.nl

# Portaal deurwaarder
DEURWAARDER_PASSWORD=    # wachtwoord voor /deurwaarder (geef dit aan Armaere)
DEURWAARDER_NAAM=Armaere
DEURWAARDER_EMAIL=       # optioneel: mail bij elk nieuw dossier

# Optioneel: zonder deze draait het onderdeel in demo-modus
KVK_API_KEY=             # KvK API, Basisprofiel
RESEND_API_KEY=          # e-mail versturen
MAIL_FROM=               # bijv. Pouw Vervoer <planning@boekpouwvervoer.nl>
LOGO_URL=                # optioneel: ander logo; standaard public/logo.png
MOLLIE_API_KEY=          # iDEAL (nog niet aangesloten; zie README)
ANTHROPIC_API_KEY=       # AI-assistent (intake in één zin, uitleg bij de score, concept-mails)
ANTHROPIC_MODEL=         # optioneel, standaard claude-opus-5-5

# Voorwaarden (standaard de meegeleverde pdf public/documenten/knv-busvervoer-2025.pdf)
VOORWAARDEN_VERSIE=      # bijv. KNV Busvervoer 2025; verhoog bij nieuwe voorwaarden
VOORWAARDEN_URL=         # optioneel: externe link naar de pdf
BEDRIJF_KVK=             # KvK-nummer van Pouw Vervoer, voor de wettelijke informatie vóór de bestelling
BEDRIJF_BTW=             # btw-nummer, idem

# Kaart (standaard OpenFreeMap: wereldwijd, gratis, zonder sleutel)
KAART_STIJL_URL=         # optioneel: andere MapLibre-stijl, bijv. van MapTiler met sleutel
KAART_HOSTS=             # optioneel: extra hosts voor de Content-Security-Policy als die stijl van meerdere domeinen laadt

# Beleid Pouw (zoals de huidige offertetool het hanteert)
BEDENKTIJD_UREN=24       # kosteloos annuleren binnen dit aantal uren na het akkoord
WIJZIGEN_TOT_DAGEN=7     # tot zoveel dagen voor vertrek kosteloos wijzigen
OFFERTE_GELDIG_DAGEN=14  # geldigheid van de prijs in de offerte
MAIL_PLANNING=           # waar wijzigingsverzoeken heen gaan, standaard info@pouwvervoer.nl

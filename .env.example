# Verplicht
DATABASE_URL=            # door Railway gezet via de Postgres-plugin: ${{Postgres.DATABASE_URL}}
ADMIN_PASSWORD=          # alleen voor de allereerste login: maakt dan een beheerdersaccount met 2FA; daarna werkt het niet meer
SESSION_SECRET=          # lange willekeurige string
NODE_ENV=production
BASE_URL=https://boekpouwvervoer.nl

# Portaal deurwaarder
DEURWAARDER_PASSWORD=    # alleen voor de allereerste login op /deurwaarder: maakt dan het eerste account van de deurwaarder met 2FA
DEURWAARDER_NAAM=Armaere
DEURWAARDER_EMAIL=       # optioneel: mail bij elk nieuw dossier

# Optioneel: zonder deze draait het onderdeel in demo-modus
KVK_API_KEY=             # KvK API, Basisprofiel
RESEND_API_KEY=          # e-mail versturen
MAIL_FROM=               # bijv. Pouw Vervoer <planning@boekpouwvervoer.nl>
LOGO_URL=                # optioneel: ander logo; standaard public/logo.png
MOLLIE_API_KEY=          # iDEAL (nog niet aangesloten; zie README)
ANTHROPIC_API_KEY=       # AI-assistent (intake in één zin, uitleg bij de score, concept-mails)
ANTHROPIC_MODEL=         # optioneel, standaard claude-opus-5-5

# Voorwaarden (standaard de meegeleverde pdf public/documenten/knv-busvervoer-2025.pdf)
VOORWAARDEN_VERSIE=      # bijv. KNV Busvervoer 2025; verhoog bij nieuwe voorwaarden
VOORWAARDEN_URL=         # optioneel: externe link naar de pdf
BEDRIJF_KVK=             # KvK-nummer van Pouw Vervoer, voor de wettelijke informatie vóór de bestelling
BEDRIJF_BTW=             # btw-nummer, idem

# Kaart (standaard OpenFreeMap: wereldwijd, gratis, zonder sleutel)
KAART_STIJL_URL=         # optioneel: andere MapLibre-stijl, bijv. van MapTiler met sleutel
KAART_HOSTS=             # optioneel: extra hosts voor de Content-Security-Policy als die stijl van meerdere domeinen laadt

# Beleid Pouw (zoals de huidige offertetool het hanteert)
BEDENKTIJD_UREN=24       # kosteloos annuleren binnen dit aantal uren na het akkoord
WIJZIGEN_TOT_DAGEN=7     # tot zoveel dagen voor vertrek kosteloos wijzigen
OFFERTE_GELDIG_DAGEN=14  # geldigheid van de prijs in de offerte
MAIL_PLANNING=           # waar wijzigingsverzoeken en klachten heen gaan, standaard info@pouwvervoer.nl
MELDING_WERKDAGEN=5      # standaarddeadline van een melding in werkdagen
WETTELIJKE_RENTE_PCT=6   # wettelijke rente voor particulieren, per jaar; controleer het geldende percentage

# AFAS Online (zonder AFAS_TOKEN en AFAS_OMGEVING: demo-modus, boekingen worden gelogd maar niet verstuurd)
AFAS_TOKEN=              # token van de app-connector in AFAS (Algemeen > Beheer > App connector)
AFAS_OMGEVING=           # omgevingsnummer, het cijferdeel van https://<nummer>.rest.afas.online
AFAS_OMGEVING_TYPE=rest  # rest (productie), resttest of restaccept
AFAS_DAGBOEK=70          # verkoopboek
AFAS_DAGBOEK_BANK=80     # bankboek voor ontvangsten en aanbetalingen
AFAS_GROOTBOEK_OMZET=8000      # omzet busvervoer (9%)
AFAS_GROOTBOEK_NAKOSTEN=8010   # nakosten (tol, parkeren, pont 9%; schoonmaak, schade, verblijf 21%)
AFAS_GROOTBOEK_BTW_9=1500      # af te dragen btw laag
AFAS_GROOTBOEK_BTW_21=1510     # af te dragen btw hoog
AFAS_GROOTBOEK_VOORUIT=1700    # vooruitontvangen bedragen (aanbetalingen tot de eindfactuur)
AFAS_GROOTBOEK_BANK=1100       # bankrekening (iDEAL/Mollie, overschrijvingen, ontvangsten via Armaere)
AFAS_GROOTBOEK_INCASSO=        # rente en incassokosten (zonder btw); standaard de omzetrekening
AFAS_BTW_CODE_9=2              # btw-code laag tarief in AFAS
AFAS_BTW_CODE_21=1             # btw-code hoog tarief
AFAS_BTW_CODE_0=0              # btw-code geen btw
AFAS_BETALINGSCONDITIE=14      # betalingsconditie (PaCd) voor nieuwe debiteuren
AFAS_BTWPLICHT=1               # btw-plicht (VaDu) voor nieuwe debiteuren
AFAS_NAKOSTEN_21=schoon,schade,rotzooi,vervuil,verblijf,maaltijd,hotel   # trefwoorden in nakosten die 21% krijgen

# WhatsApp en sms via SMSTools (zonder sleutels: demo-modus, berichten alleen in het dossier)
SMSTOOLS_CLIENT_ID=      # Developer > API & Webhooks > API credentials
SMSTOOLS_CLIENT_SECRET=
SMSTOOLS_SENDER=         # WhatsApp Business-nummer van Pouw, internationaal zonder plus (31306868300)
SMSTOOLS_SMS_SENDER=Pouw # afzendernaam voor sms (maximaal 11 tekens)
SMSTOOLS_WEBHOOK_SECRET= # secret van de webhook (eenmalig getoond bij het aanmaken) voor de handtekeningcontrole
SMSTOOLS_TPL_OFFERTE=pouw_offerte          # namen van de goedgekeurde WhatsApp-templates (zie README)
SMSTOOLS_TPL_AANBETALING=pouw_aanbetaling
SMSTOOLS_TPL_FACTUUR=pouw_factuur
SMSTOOLS_TPL_RIT=pouw_rit_morgen
SMSTOOLS_TPL_BRIEF=pouw_brief

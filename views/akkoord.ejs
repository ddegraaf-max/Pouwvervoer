<%- include('partials/head', { titel: 'Offerte ter akkoord', kaart: true }) %>
<main class="wrap"><div class="narrow" style="display:flex;flex-direction:column;gap:16px">
  <% const fase = a.status === 'offerte_verstuurd' ? 2 : a.status === 'wacht_op_betaling' ? 3 : 5; %>
  <ol class="voortgang" aria-label="Voortgang">
    <% ['Offerte', 'Goedkeuren', 'Aanbetaling', 'Rit vast'].forEach((s, i) => { const nr = i + 1; %>
      <li data-nr="<%= nr %>" class="<%= nr < fase ? 'klaar' : nr === fase ? 'nu' : '' %>"<%= nr === fase ? ' aria-current="step"' : '' %>><%= s %></li>
    <% }) %>
  </ol>
  <div>
    <div class="lead" style="margin:0">Offerte EPV-<%= a.id %> van Pouw Vervoer</div>
    <h1><%= a.status === 'offerte_verstuurd' ? 'Offerte voor uw busrit' : 'Uw busrit' %></h1>
    <% if (a.status === 'offerte_verstuurd') { %><p class="lead" style="margin:0">Controleer de gegevens hieronder. Klopt alles? Geef onderaan uw akkoord.</p><% } %>
  </div>

  <% if (locals.melding) { %><div class="alert ok" role="status"><%= melding %></div><% } %>
  <% if (locals.verlopen) { %><div class="alert bad"><strong>Deze offerte is verlopen</strong> (prijs geldig t/m <%= datum(a.offerte_geldig_tot) %>). Bel 030 68 68 300 voor een nieuwe prijs; de planning kan de offerte ook opnieuw versturen.</div><% } %>
  <% if (a.wijziging_open) { %><div class="alert info">Uw wijzigingsverzoek is ontvangen; onze planning neemt contact met u op en bevestigt de wijziging per e-mail.</div><% } %>
  <% if (a.status === 'bevestigd' || a.status === 'gereden') { %>
    <div class="alert ok"><strong>De rit is bevestigd</strong> en staat vast in onze planning.</div>
  <% } else if (a.status === 'wacht_op_betaling') { %>
    <div class="alert info"><strong>Akkoord ontvangen.</strong> De bus staat vast zodra de aanbetaling binnen is.</div>
  <% } else if (a.status === 'geannuleerd') { %>
    <div class="alert bad">Deze rit is geannuleerd. Bel 030 68 68 300 bij vragen.</div>
  <% } else if (['gefactureerd','betaald'].includes(a.status)) { %>
    <div class="alert ok">Deze rit is uitgevoerd. De eindfactuur is naar <%= a.factuur_email %> gestuurd.</div>
  <% } %>

  <div class="card">
    <div class="lead" style="margin:0 0 6px;font-size:13px;font-weight:600;text-transform:uppercase;letter-spacing:.04em">Opdrachtgever</div>
    <div style="font-weight:600;font-size:17px"><%= k.naam %><% if (k.type === 'particulier') { %> (particulier)<% } %></div>
    <div class="lead" style="margin:4px 0 0">Aangevraagd door <%= a.aanvrager_naam %><% if (a.aanvrager_rol) { %>, <%= a.aanvrager_rol %><% } %></div>
  </div>

  <div class="card">
    <%- include('partials/reis-samenvatting', { r: vanAanvraag(a) }) %>
    <dl class="kv" style="margin-top:8px">
      <% if (a.opmerkingen) { %><dt>Bijzonderheden</dt><dd><%= a.opmerkingen %></dd><% } %>
      <% if (a.afspraken) { %><dt>Afspraken</dt><dd style="white-space:pre-wrap"><%= a.afspraken %></dd><% } %>
      <% if (a.po_nummer) { %><dt>Uw referentie</dt><dd><%= a.po_nummer %></dd><% } %>
      <dt>Factuur naar</dt><dd><%= a.factuur_email %></dd>
    </dl>
    <div class="between" style="border-top:1px solid var(--line);margin-top:14px;padding-top:14px">
      <strong>Ritprijs incl. 9% btw</strong><span class="price"><%= euro(a.ritprijs_cent) %></span>
    </div>
    <p class="lead" style="margin:8px 0 0;font-size:14px"><%= a.offerte_geldig_tot && a.status === 'offerte_verstuurd' ? `Prijs geldig t/m ${datum(a.offerte_geldig_tot)}. ` : '' %>Parkeergeld, tol, pont en verblijfskosten van de chauffeur komen op de eindfactuur. Op deze offerte en de rit zijn de <a href="<%= voorwaarden.url %>" target="_blank" rel="noopener">Algemene Vervoer- en Reisvoorwaarden van KNV Busvervoer</a> (<%= voorwaarden.versie %>) van toepassing.</p>
  </div>

  <div class="card soft">
    <h2 style="font-size:17px;margin-bottom:8px">Zo werkt het bij Pouw Vervoer</h2>
    <ul class="kern" style="margin:0"><% beleid.punten.forEach((p) => { %><li><%= p %></li><% }) %></ul>
  </div>

  <div class="card">
    <h2 style="font-size:17px;margin-bottom:10px">Annuleren en bedenktijd</h2>
    <%- include('partials/voorwaarden-annulering', { ritprijs: a.ritprijs_cent }) %>
  </div>

  <div class="card">
    <h2 style="font-size:17px;margin-bottom:6px">Uw vervoerder</h2>
    <p style="margin:0"><%= voorwaarden.bedrijfRegel %>.</p>
    <p class="lead" style="margin:8px 0 0;font-size:14px">Klachten dient u direct en uiterlijk binnen een maand schriftelijk in; daarna kunt u naar de geschillencommissie van Busvervoer Nederland (artikel 11). Na uw akkoord ontvangt u een bevestiging per e-mail met de volledige voorwaarden als pdf.</p>
  </div>

  <div class="card soft">
    <h2 style="font-size:17px;margin-bottom:10px">Betaling</h2>
    <% if (a.status === 'offerte_verstuurd') { %>
      <% if (!plan.termijnen.length) { %>
        <p style="margin:0">Geen aanbetaling nodig. U ontvangt na de rit één eindfactuur met 14 dagen betaaltermijn.</p>
      <% } else { plan.termijnen.forEach(t => { %>
        <div class="between"><span><%= t.label %><%= t.uiterlijk ? `, uiterlijk ${datum(t.uiterlijk)}` : '' %></span><strong><%= euro(t.bedrag) %></strong></div>
      <% }) } %>
    <% } else if (termijnen.length) { termijnen.forEach(t => { %>
      <div class="between" style="padding:6px 0">
        <span><%= t.label %><%= t.uiterlijk ? `, uiterlijk ${datum(t.uiterlijk)}` : '' %></span>
        <% if (t.betaald_op) { %><span class="badge k-A">Betaald</span><% } else { %><a class="btn small zin" href="/betalen/<%= t.token %>">Betaal <%= euro(t.bedrag_cent) %></a><% } %>
      </div>
    <% }) } else { %>
      <p style="margin:0">Geen aanbetaling nodig. U ontvangt na de rit één eindfactuur.</p>
    <% } %>
  </div>

  <% if (['wacht_op_betaling', 'bevestigd'].includes(a.status)) { %>
  <div class="card">
    <h2 style="font-size:17px;margin-bottom:6px">Bedenktijd</h2>
    <% if (locals.binnenBedenktijd) { %>
      <p style="margin:0 0 10px">U kunt tot <strong><%= datumTijd(bedenktijdTot) %></strong> kosteloos annuleren (0% annuleringskosten).</p>
      <% if (fout) { %><div class="alert bad" role="alert" style="margin-bottom:10px"><%= fout %></div><% } %>
      <form method="post" action="/akkoord/<%= a.akkoord_token %>/annuleren" style="display:flex;flex-direction:column;gap:10px">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label class="check" for="annbevestig"><input type="checkbox" id="annbevestig" name="bevestig"><span>Ja, ik wil deze boeking annuleren. Dit kan niet ongedaan worden gemaakt.</span></label>
        <div><button class="btn danger" type="submit">Boeking annuleren</button></div>
      </form>
    <% } else { %>
      <p class="lead" style="margin:0;font-size:14px">De bedenktijd van <%= beleid.uren %> uur liep af op <%= datumTijd(bedenktijdTot) %>. Annuleren kan nog wel, schriftelijk per e-mail naar <a href="mailto:<%= voorwaarden.bedrijf.email %>"><%= voorwaarden.bedrijf.email %></a>; dan gelden de annuleringskosten hierboven.</p>
      <% if (fout) { %><div class="alert bad" role="alert" style="margin-top:10px"><%= fout %></div><% } %>
    <% } %>
  </div>

  <div class="card">
    <h2 style="font-size:17px;margin-bottom:6px">Wijziging doorgeven</h2>
    <p class="lead" style="margin:0 0 10px;font-size:14px"><%= locals.wijzigenKosteloos ? `Tot en met ${datum(new Date(wijzigenTot.getTime() - 864e5))} wijzigt u kosteloos.` : `Uw rit is binnen ${beleid.dagen} dagen; wijzigen kan in overleg, mogelijk met meerkosten.` %> Wij bevestigen elke wijziging per e-mail.</p>
    <form method="post" action="/akkoord/<%= a.akkoord_token %>/wijziging" style="display:flex;flex-direction:column;gap:10px">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div><label for="wcat">Wat wilt u wijzigen?</label><select id="wcat" name="categorie"><% Object.entries(beleid.categorieen).forEach(([sleutel, lab]) => { %><option value="<%= sleutel %>"><%= lab %></option><% }) %></select></div>
      <div><label for="wtekst">Toelichting</label><textarea id="wtekst" name="tekst" placeholder="Bijv. graag een half uur later vertrekken, om 09:00."></textarea></div>
      <div><button class="btn ghost" type="submit">Wijziging doorgeven</button></div>
    </form>
  </div>
  <% } %>

  <% if (['wacht_op_betaling', 'bevestigd', 'gereden', 'gefactureerd', 'betaald'].includes(a.status)) { %>
  <div class="card">
    <h2 style="font-size:17px;margin-bottom:6px">Klacht of vraag</h2>
    <p class="lead" style="margin:0 0 10px;font-size:14px">Is er iets niet goed gegaan? Meld het hier, dan pakt onze administratie het op. Wij nemen binnen 5 werkdagen contact op en handelen een klacht binnen een maand af (artikel 11 van de voorwaarden). Zolang uw klacht in behandeling is, sturen wij geen betalingsherinneringen.</p>
    <form method="post" action="/akkoord/<%= a.akkoord_token %>/klacht" style="display:flex;flex-direction:column;gap:10px">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div><label for="ktekst">Wat is er gebeurd?</label><textarea id="ktekst" name="tekst" placeholder="Bijv. de bus was 25 minuten te laat bij de school, waardoor we de eerste activiteit misten."></textarea></div>
      <div><button class="btn ghost" type="submit">Klacht indienen</button></div>
    </form>
  </div>
  <% } %>

  <% if (a.status === 'offerte_verstuurd' && !locals.verlopen) { %>
  <form method="post" class="card" style="display:flex;flex-direction:column;gap:12px">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <% if (fout) { %><div class="alert bad" role="alert"><%= fout %></div><% } %>
    <div><label for="naam">Uw naam</label><input type="text" id="naam" name="naam" autocomplete="name" value="<%= k.tekenbevoegde || '' %>" required></div>
    <label class="check" for="voorwaarden"><input type="checkbox" id="voorwaarden" name="voorwaarden"><span>Ik ga akkoord met deze offerte en accepteer de <a href="<%= voorwaarden.url %>" target="_blank" rel="noopener">Algemene Vervoer- en Reisvoorwaarden van KNV Busvervoer</a> (<%= voorwaarden.versie %>), inclusief de annuleringsregeling hierboven. Ik weet dat ik <%= beleid.uren %> uur bedenktijd heb en dat daarna de annuleringsregeling geldt. Ik mag tekenen namens <%= k.naam %>.</span></label>
    <button class="btn wide zin" type="submit"><%= plan.termijnen.some(t => !t.uiterlijk) ? `Akkoord met betalingsverplichting en ${euro(plan.termijnen.find(t => !t.uiterlijk).bedrag)} betalen met iDEAL` : 'Akkoord: bestelling met betalingsverplichting' %></button>
    <p class="lead" style="margin:8px 0 0;font-size:13px;text-align:center">Met deze knop sluit u een overeenkomst met betalingsverplichting voor <%= euro(a.ritprijs_cent) %> plus eventuele nakosten.</p>
  </form>
  <% } %>
  <p class="lead" style="text-align:center">Vraag over de offerte? Bel <a href="tel:0306868300">030 68 68 300</a></p>
</div></main>
<%- include('partials/foot') %>

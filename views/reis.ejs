<%- include('partials/head', { titel: 'Uw reis', opAanvraag: true, script: '/reis.js', kaart: true }) %>
<section class="band foto"><div class="wrap">
  <h1>Stel uw reis samen</h1>
  <p>Van, naar, wanneer en met hoeveel personen. Meer hebben we voor een prijs niet nodig.</p>
</div></section>
<main class="wrap wizard">
  <ol class="stappen" aria-label="Stappen">
    <li class="nu" aria-current="step"><span class="nr">1</span><span class="tekst">Uw reis</span></li>
    <li><span class="nr">2</span><span class="tekst">Uw gegevens</span></li>
    <li><span class="nr">3</span><span class="tekst">Offerte en akkoord</span></li>
  </ol>

  <% if (!demo.assistent) { %>
  <section class="card intake" data-intake aria-labelledby="intake-kop">
    <div class="intake-kop">
      <span class="intake-icoon" aria-hidden="true"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2l1.8 5.7 5.7 1.8-5.7 1.8L12 17l-1.8-5.7L4.5 9.5l5.7-1.8zM19 14l.9 2.6 2.6.9-2.6.9L19 21l-.9-2.6-2.6-.9 2.6-.9zM5 15l.7 2 2 .7-2 .7L5 20.5l-.7-2.1-2-.7 2-.7z"/></svg></span>
      <div>
        <h2 id="intake-kop">Vertel in één zin wat u wilt</h2>
        <p class="lead">Onze assistent vult het formulier hieronder voor u in. U controleert het en klikt op Verder.</p>
      </div>
    </div>
    <div class="intake-rij">
      <label class="sr-only" for="intake-tekst">Uw reis in één zin</label>
      <textarea id="intake-tekst" rows="2" maxlength="1500" placeholder="Bijv. schoolreis naar de Efteling op 12 mei met 48 kinderen en 6 begeleiders, vanaf de Mariaschool in Vianen, om 17:00 terug"></textarea>
      <button type="button" class="mic" data-mic hidden aria-pressed="false" aria-label="Inspreken"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 15a4 4 0 0 0 4-4V6a4 4 0 0 0-8 0v5a4 4 0 0 0 4 4zm6-4a6 6 0 0 1-12 0H4a8 8 0 0 0 7 7.93V22h2v-3.07A8 8 0 0 0 20 11h-2z"/></svg></button>
    </div>
    <div class="intake-acties">
      <button type="button" class="btn geel zin" data-intake-knop>Vul het formulier in</button>
      <span class="hint" data-intake-status role="status" aria-live="polite"></span>
    </div>
    <p class="alert info" data-intake-resultaat hidden></p>
  </section>
  <% } %>

  <form method="post" action="/reis" novalidate data-reis class="card reis" data-vandaag="<%= vandaag %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="kop">
      <div>
        <h2 class="titel">Uw reis</h2>
        <p class="lead">Vrijblijvend, we vragen nog geen persoonlijke gegevens.</p>
      </div>
      <% if (opgeslagen) { %><button class="btn ghost small" type="submit" formaction="/reis/opnieuw" formnovalidate>Opnieuw beginnen</button><% } %>
    </div>

    <% if (lijst.length) { %>
    <div class="alert bad" role="alert"><strong>Bijna klaar. Controleer nog:</strong><ul><% lijst.forEach((f) => { %><li><%= f %></li><% }) %></ul></div>
    <% } %>

    <div class="grid2 basis">
      <fieldset class="segment">
        <legend>Ritsoort</legend>
        <div class="keuzes">
          <label><input type="radio" name="reistype" value="retour"<%= v.reistype === 'retour' ? ' checked' : '' %>><span>Retour</span></label>
          <label><input type="radio" name="reistype" value="enkel"<%= v.reistype === 'enkel' ? ' checked' : '' %>><span>Enkele reis</span></label>
        </div>
        <p class="fout" id="reistype-fout"><%= fouten.reistype || '' %></p>
      </fieldset>
      <div>
        <label for="personen">Aantal personen</label>
        <input type="number" id="personen" name="personen" min="1" max="15000" inputmode="numeric" placeholder="45" value="<%= v.personen || '' %>"<%- fouten.personen ? ' aria-invalid="true" aria-describedby="personen-fout"' : '' %>>
        <p class="fout" id="personen-fout"><%= fouten.personen || '' %></p>
      </div>
    </div>

    <section class="leg" aria-labelledby="heen-kop">
      <h2 class="leg-kop" id="heen-kop"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M4 5.5A2.5 2.5 0 0 1 6.5 3h10A5.5 5.5 0 0 1 22 8.5V16a2 2 0 0 1-2 2h-.3a2.75 2.75 0 0 1-5.4 0H9.7a2.75 2.75 0 0 1-5.4 0H4a2 2 0 0 1-2-2V5.5zm2 .5v4.5h5V6H6zm7 0v4.5h6.9A3.5 3.5 0 0 0 16.5 6H13z"/><circle cx="7" cy="18.3" r="2.1" fill="currentColor"/><circle cx="17" cy="18.3" r="2.1" fill="currentColor"/></svg>Heenreis</h2>
      <%- include('partials/reis-route', { prefix: '', v, fouten, terug: false }) %>
      <div class="kaart" data-kaart-live hidden aria-label="Kaart van de route"></div>
      <p class="lead" data-kaart-info style="font-size:13px;margin:0 0 16px"></p>
      <%- include('partials/reis-wanneer', { p: 'heen', v, fouten, vandaag, legenda: 'Is dit de vertrek- of aankomsttijd van de heenreis?', labelDatum: 'Datum heenreis', labelTijd: 'Tijd heenreis' }) %>
    </section>

    <section class="leg" aria-labelledby="terug-kop" data-terug<%= v.reistype === 'enkel' ? ' hidden' : '' %>>
      <h2 class="leg-kop" id="terug-kop"><svg class="spiegel" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M4 5.5A2.5 2.5 0 0 1 6.5 3h10A5.5 5.5 0 0 1 22 8.5V16a2 2 0 0 1-2 2h-.3a2.75 2.75 0 0 1-5.4 0H9.7a2.75 2.75 0 0 1-5.4 0H4a2 2 0 0 1-2-2V5.5zm2 .5v4.5h5V6H6zm7 0v4.5h6.9A3.5 3.5 0 0 0 16.5 6H13z"/><circle cx="7" cy="18.3" r="2.1" fill="currentColor"/><circle cx="17" cy="18.3" r="2.1" fill="currentColor"/></svg>Terugreis</h2>
      <div class="schakel">
        <label class="switch"><input type="checkbox" role="switch" name="andere_route" id="andere_route"<%= v.andere_route ? ' checked' : '' %>><span class="knop" aria-hidden="true"></span>Andere route terug</label>
        <button type="button" class="info-knop" aria-expanded="false" aria-controls="uitleg-route" aria-label="Uitleg: andere route terug">i</button>
        <p class="hint uitleg" id="uitleg-route" hidden>Standaard rijdt de bus dezelfde route terug. Zet dit aan als de terugreis ergens anders begint of eindigt, of via andere tussenstops loopt.</p>
      </div>
      <%- include('partials/reis-route', { prefix: 'terug_', v, fouten, terug: true }) %>
      <%- include('partials/reis-wanneer', { p: 'terug', v, fouten, vandaag, legenda: 'Is dit de vertrektijd van de terugreis of de aankomsttijd op de opstapplaats?', labelDatum: 'Datum terugreis', labelTijd: 'Tijd terugreis' }) %>
    </section>

    <div class="actie">
      <button class="btn wide" type="submit">Verder naar uw gegevens</button>
      <p class="hint">Gratis en vrijblijvend. U betaalt pas na goedkeuring van de offerte.</p>
    </div>
  </form>

  <template id="tpl-stop"><%- include('partials/reis-stop', { prefix: '', i: 0, waarde: '', wacht: 15, fout: '' }) %></template>

  <p class="bellen">Liever bellen? <a href="tel:0306868300"><strong>030 68 68 300</strong></a>, maandag tot en met vrijdag van 08:00 tot 17:30.</p>
</main>
<%- include('partials/foot') %>

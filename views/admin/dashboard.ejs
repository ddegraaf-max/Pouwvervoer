<%- include('../partials/head', { titel: 'Dashboard', admin: true }) %>
<%
const k = d.kerncijfers;
const pct = (v) => (v == null ? '-' : `${Math.round(v * 100)}%`);
const dec = (v) => String(v).replace('.', ',');
const delta = (nu, vorig, soort) => {
  if (nu == null || vorig == null) return '<span class="lead" style="font-size:13px">geen vergelijking</span>';
  const v = nu - vorig;
  const tekst = soort === 'euro' ? euro(Math.abs(v)) : soort === 'pct' ? `${Math.round(Math.abs(v) * 100)} punt${Math.round(Math.abs(v) * 100) === 1 ? '' : 'en'}` : `${dec(Math.round(Math.abs(v) * 10) / 10)} dagen`;
  const beter = soort === 'pct' ? v >= 0 : v <= 0;
  return `<span class="delta ${v === 0 ? '' : beter ? 'goed' : 'slecht'}">${v === 0 ? 'gelijk aan' : (v > 0 ? '+' : '−') + tekst + ' t.o.v.'} vorige maand</span>`;
};
const maxWeek = Math.max(1, ...d.weken.map((w) => w.open));
const csvLink = (t) => `<a class="btn small ghost" href="/admin/dashboard.csv?tabel=${t}">CSV</a>`;
const vorige = new Date(d.vorigePeildatum);
const rapportMaand = `${vorige.getUTCFullYear()}-${String(vorige.getUTCMonth() + 1).padStart(2, '0')}`;
%>
<main class="wrap dashboard" style="display:flex;flex-direction:column;gap:20px">
  <div class="between" style="flex-wrap:wrap;gap:10px">
    <div><h1 style="margin:0">Dashboard</h1><p class="lead" style="margin:4px 0 0;font-size:14px">Peildatum <%= datum(d.peildatum) %>, vergeleken met <%= datum(d.vorigePeildatum) %>. Hoofdsommen inclusief btw, na creditnota's; rechtstreeks uit de database.</p></div>
    <div style="display:flex;gap:8px;flex-wrap:wrap"><a class="btn small ghost" href="/admin/dashboard/rapport.pdf?maand=<%= rapportMaand %>">Maandrapport <%= rapportMaand %> (pdf)</a><a class="btn small ghost" href="/admin/dashboard/rapport.pdf">Rapport tot vandaag (pdf)</a></div>
  </div>

  <div class="kerncijfers">
    <div class="card cijfer"><div class="label">Totaal openstaand</div><div class="waarde"><%= euro(k.openstaand.nu) %></div><%- delta(k.openstaand.nu, k.openstaand.vorig, 'euro') %></div>
    <div class="card cijfer"><div class="label">Waarvan vervallen</div><div class="waarde <%= k.vervallen.nu > 0 ? 'rood' : '' %>"><%= euro(k.vervallen.nu) %></div><%- delta(k.vervallen.nu, k.vervallen.vorig, 'euro') %></div>
    <div class="card cijfer"><div class="label">DSO <span class="lead" style="font-size:12px">(90 dagen)</span></div><div class="waarde"><%= k.dso.nu == null ? '-' : `${dec(k.dso.nu)} dagen` %></div><%- delta(k.dso.nu, k.dso.vorig, 'dagen') %></div>
    <div class="card cijfer"><div class="label">Binnen de termijn betaald</div><div class="waarde"><%= pct(k.opTijd.nu) %></div><%- delta(k.opTijd.nu, k.opTijd.vorig, 'pct') %></div>
    <div class="card cijfer"><div class="label">Vooraf via aanbetalingen</div><div class="waarde groen"><%= euro(k.aanbetalingen.nu) %></div><%- delta(k.aanbetalingen.nu, k.aanbetalingen.vorig, 'euro') %></div>
  </div>

  <div class="card">
    <div class="between" style="flex-wrap:wrap;gap:8px"><h2 style="font-size:18px;margin:0">Openstaand en vervallen per week</h2><%- csvLink('weken') %></div>
    <p class="lead" style="font-size:13px;margin:4px 0 10px">Laatste 26 weken, stand per week-einde. Navy: openstaand; rood: waarvan vervallen.</p>
    <svg viewBox="0 0 800 230" class="grafiek" role="img" aria-label="Openstaand en vervallen per week">
      <line x1="40" y1="190" x2="790" y2="190" stroke="#9AA3BF" stroke-width="1"/>
      <text x="4" y="24" font-size="11" fill="#5B6478"><%= euro(maxWeek) %></text>
      <text x="4" y="190" font-size="11" fill="#5B6478">0</text>
      <% d.weken.forEach((w, i) => { const x = 44 + i * 28.6; const h = (w.open / maxWeek) * 160; const hv = (w.vervallen / maxWeek) * 160; %>
        <rect x="<%= x %>" y="<%= 190 - h %>" width="18" height="<%= h %>" fill="#263680"><title><%= w.week %>: openstaand <%= euro(w.open) %>, vervallen <%= euro(w.vervallen) %></title></rect>
        <rect x="<%= x + 4 %>" y="<%= 190 - hv %>" width="10" height="<%= hv %>" fill="#A12A1E"/>
        <% if (i % 4 === 1 || i === d.weken.length - 1) { %><text x="<%= x + 9 %>" y="212" font-size="10" fill="#5B6478" text-anchor="middle"><%= w.week.slice(5) %></text><% } %>
      <% }) %>
    </svg>
  </div>

  <div class="cols">
    <section class="main">
      <div class="card">
        <div class="between" style="flex-wrap:wrap;gap:8px"><h2 style="font-size:18px;margin:0">Ouderdomsanalyse</h2><%- csvLink('ouderdom') %></div>
        <div class="scroll"><table><thead><tr><th>Ouderdom</th><th class="num">Facturen</th><th class="num">Bedrag</th><th></th></tr></thead><tbody>
          <% d.ouderdom.forEach((b) => { %><tr><td><%= b.label %></td><td class="num"><%= b.aantal %></td><td class="num"><%= euro(b.bedrag) %></td><td style="padding-left:20px"><% if (b.aantal) { %><a href="/admin/dashboard/facturen?bucket=<%= b.id %>">Bekijk facturen</a><% } %></td></tr><% }) %>
        </tbody></table></div>
      </div>
      <div class="card">
        <div class="between" style="flex-wrap:wrap;gap:8px"><h2 style="font-size:18px;margin:0">Per klantklasse</h2><%- csvLink('klasse') %></div>
        <p class="lead" style="font-size:13px;margin:4px 0 10px">Facturen van de laatste 12 maanden. Hieraan ziet u of de klassegrenzen kloppen: klasse A hoort het minst te laat te betalen.</p>
        <div class="scroll"><table><thead><tr><th>Klasse</th><th class="num">Ritten</th><th class="num">Omzet</th><th class="num">Te laat betaald</th><th class="num">Gem. dagen te laat</th></tr></thead><tbody>
          <% d.perKlasse.forEach((g) => { %><tr><td><span class="badge k-<%= g.groep %>"><%= g.groep %></span></td><td class="num"><%= g.ritten %></td><td class="num"><%= euro(g.omzet) %></td><td class="num"><%= pct(g.aandeelTeLaat) %></td><td class="num"><%= dec(g.gemDagenTeLaat) %></td></tr><% }) %>
        </tbody></table></div>
      </div>
      <div class="card">
        <div class="between" style="flex-wrap:wrap;gap:8px"><h2 style="font-size:18px;margin:0">Per klanttype</h2><%- csvLink('klanttype') %></div>
        <div class="scroll"><table><thead><tr><th>Klanttype</th><th class="num">Ritten</th><th class="num">Omzet</th><th class="num">Te laat betaald</th><th class="num">Gem. dagen te laat</th></tr></thead><tbody>
          <% d.perKlanttype.forEach((g) => { %><tr><td><%= KLANTTYPE[g.groep] || g.groep %></td><td class="num"><%= g.ritten %></td><td class="num"><%= euro(g.omzet) %></td><td class="num"><%= pct(g.aandeelTeLaat) %></td><td class="num"><%= dec(g.gemDagenTeLaat) %></td></tr><% }) %>
        </tbody></table></div>
      </div>
    </section>
    <aside class="side">
      <div class="card">
        <div class="between" style="flex-wrap:wrap;gap:8px"><h2 style="font-size:18px;margin:0">Bij <%= deurwaarder %></h2><%- csvLink('armaere') %></div>
        <dl class="kv" style="margin-top:8px">
          <dt>Lopende dossiers</dt><dd><%= d.armaere.aantal %></dd>
          <dt>Hoofdsom</dt><dd><%= euro(d.armaere.hoofdsom) %></dd>
          <dt>Ontvangen</dt><dd><%= euro(d.armaere.ontvangen) %></dd>
          <dt>Slagingspercentage</dt><dd><%= pct(d.armaere.slaging) %> <span class="lead" style="font-size:12px">(gesloten dossiers die volledig zijn betaald)</span></dd>
          <dt>Ooit overgedragen</dt><dd><%= d.armaere.totaalOoit %> dossiers, <%= euro(d.armaere.ontvangenOoit) %> van <%= euro(d.armaere.hoofdsomOoit) %> ontvangen</dd>
        </dl>
      </div>
    </aside>
  </div>

  <div class="card">
    <div class="between" style="flex-wrap:wrap;gap:8px"><h2 style="font-size:18px;margin:0">Top 10 debiteuren op openstaand bedrag</h2><%- csvLink('debiteuren') %></div>
    <% if (!d.debiteuren.length) { %><p class="lead" style="margin:8px 0 0">Niets openstaand.</p><% } else { %>
    <div class="scroll"><table><thead><tr><th>Debiteur</th><th>Klasse</th><th>Type</th><th class="num">Open</th><th class="num">Waarvan vervallen</th><th class="num">Facturen</th><th>Laatste herinnering</th></tr></thead><tbody>
      <% d.debiteuren.forEach((x) => { %><tr><td><%= x.klant %><%= x.incasso ? ` <span class="badge k-D">${deurwaarder}</span>` : '' %></td><td><span class="badge k-<%= x.klasse %>"><%= x.klasse %></span></td><td><%= KLANTTYPE[x.type] || x.type %></td><td class="num"><%= euro(x.open) %></td><td class="num"><%= x.vervallen ? euro(x.vervallen) : '-' %></td><td class="num"><%= x.facturen %></td><td><%= x.laatsteHerinnering ? datum(x.laatsteHerinnering) : '-' %></td></tr><% }) %>
    </tbody></table></div>
    <% } %>
  </div>
</main>
<%- include('../partials/foot') %>

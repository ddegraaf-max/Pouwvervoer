<%- include('../partials/head', { titel: `EPV-${a.id}`, admin: true, kaart: true }) %>
<% const form = (actie) => `<form method="post" action="/admin/aanvraag/${a.id}/${actie}" style="margin:0"><input type="hidden" name="_csrf" value="${csrf}">`; %>
<main class="wrap" style="display:flex;flex-direction:column;gap:20px">
  <div>
    <div class="lead" style="margin:0"><a href="/admin">Aanvragen</a> · EPV-<%= a.id %> · <%= datum(a.rit_datum) %> · <%= a.van %> → <%= a.naar %></div>
    <h1><%= k.naam %></h1>
    <span class="badge st"><%= STATUS[a.status] %></span>
    <% if (a.signaal_planner) { %><span class="badge k-D">Aanbetaling 48 uur na herinnering niet binnen: beslis of de rit doorgaat</span><% } %>
    <% if (a.wijziging_open) { %><span class="badge k-C">Wijzigingsverzoek open</span><% } %>
    <% if (locals.openMeldingen) { %><span class="badge k-D"><%= openMeldingen %> melding<%= openMeldingen === 1 ? '' : 'en' %> open: herinneringen en incasso staan stil</span><% } %>
  </div>
  <% if (melding) { %><div class="alert info" role="status"><%= melding %></div><% } %>
  <% if (a.geblokkeerd) { %><div class="alert bad"><strong>Geblokkeerd:</strong> <%= a.blokkade_reden %>. Offerte kan niet worden verstuurd.</div><% } %>
  <% if (a.wijziging_open) { %><div class="alert info" style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:center"><span>Er staat een wijzigingsverzoek open; de tekst staat in het logboek. Bevestig de wijziging per e-mail aan de klant, bijvoorbeeld via de assistent.</span><%- form('wijziging-af') %><button class="btn small ghost" type="submit">Afgehandeld</button></form></div><% } %>
  <% if (a.annulering_op) { %><div class="alert info">Geannuleerd op <%= datumTijd(a.annulering_op) %><%= a.annulering_reden ? `: ${a.annulering_reden}` : '' %>. Annuleringskosten: <%= a.annulering_kosten_cent ? `${euro(a.annulering_kosten_cent)} (${a.annulering_pct}% volgens artikel 5.1)` : 'geen' %>.</div><% } %>

  <div class="cols">
  <section class="main">

    <div class="card">
      <div class="score">
        <div class="ring <%= a.klasse %>"><b><%= a.score ?? '–' %></b><small>van 100</small></div>
        <div style="flex:1 1 260px;min-width:0">
          <span class="badge k-<%= a.klasse %>">Klasse <%= a.klasse %><%= k.klasse_override ? ' (handmatig)' : '' %></span>
          <% if (plan) { %>
            <h2 style="margin:10px 0 6px"><%= plan.termijnen.length ? plan.termijnen.map(t => `${t.label}: ${euro(t.bedrag)}`).join(' · ') : 'Geen aanbetaling' %></h2>
            <p class="lead" style="margin:0"><%= plan.omschrijving %></p>
          <% } else { %>
            <h2 style="margin:10px 0 6px">Vul de ritprijs in</h2>
            <p class="lead" style="margin:0">Daarna wordt de score definitief berekend en zie je de aanbetaling.</p>
          <% } %>
        </div>
      </div>
    </div>

    <div class="card assistent">
      <h2 style="font-size:18px;margin-bottom:10px">Assistent</h2>
      <% if (demo.assistent) { %>
      <p class="lead" style="margin:0">Niet ingericht. Zet <code>ANTHROPIC_API_KEY</code> om de score te laten uitleggen en mails te laten opstellen.</p>
      <% } else { %>
      <h3>Uitleg bij de score</h3>
      <% if (a.assistent_risico) { %><p class="uitleg-score"><%= a.assistent_risico %></p><% } else { %><p class="lead" style="font-size:14px">Nog geen uitleg. De assistent zet de factoren en de aanbetaling in twee zinnen.</p><% } %>
      <%- form('assistent/risico') %><button class="btn ghost small" type="submit"><%= a.assistent_risico ? 'Opnieuw uitleggen' : 'Leg de score uit' %></button></form>

      <h3 style="margin-top:18px">Mail opstellen</h3>
      <%- form('assistent/mail') %>
        <div style="display:flex;flex-direction:column;gap:8px">
          <div><label for="aan">Aan</label><select id="aan" name="aan">
            <option value="aanvrager"<%= locals.concept && concept.aan === 'aanvrager' ? ' selected' : '' %>>Aanvrager, <%= a.aanvrager_email %></option>
            <option value="opdrachtgever"<%= locals.concept && concept.aan === 'opdrachtgever' ? ' selected' : '' %>>Tekenbevoegde, <%= k.teken_email %></option>
            <option value="factuur"<%= locals.concept && concept.aan === 'factuur' ? ' selected' : '' %>>Factuurontvanger, <%= a.factuur_email %></option>
          </select></div>
          <div><label for="vraag">Wat wilt u laten weten of beantwoorden?</label><textarea id="vraag" name="vraag" placeholder="Bijv. de klant vraagt of de bus een kwartier later kan vertrekken; dat kan, zonder meerkosten."></textarea></div>
          <div><button class="btn ghost" type="submit">Concept maken</button></div>
        </div>
      </form>
      <% if (locals.concept) { %>
      <div style="border-top:1px solid var(--line);margin-top:16px;padding-top:16px">
        <h3>Concept voor <%= concept.email %></h3>
        <%- form('mail') %>
          <input type="hidden" name="aan" value="<%= concept.aan %>">
          <div style="display:flex;flex-direction:column;gap:8px">
            <div><label for="onderwerp">Onderwerp</label><input type="text" id="onderwerp" name="onderwerp" value="<%= concept.onderwerp %>"></div>
            <div><label for="tekst">Tekst</label><textarea id="tekst" name="tekst" style="min-height:240px"><%= concept.tekst %></textarea></div>
            <div class="row"><button class="btn" type="submit">Versturen</button><span class="lead" style="margin:0;font-size:14px">Pas de tekst gerust aan voordat u verstuurt. De mail komt in het logboek.</span></div>
          </div>
        </form>
      </div>
      <% } %>
      <% } %>
    </div>

    <div class="card">
      <h2 style="font-size:18px;margin-bottom:6px">Afspraken met de klant</h2>
      <p class="lead" style="font-size:14px;margin:0 0 10px">Wat sales heeft toegezegd, zwart op wit: komt in de offerte, de bevestiging na het akkoord, de export voor trip en op deze pagina. Zo voert planning uit wat is afgesproken.</p>
      <%- form('afspraken') %>
        <div style="display:flex;flex-direction:column;gap:8px">
          <textarea name="afspraken" aria-label="Afspraken" placeholder="Bijv. chauffeur wacht bij de Efteling; bus met toilet; factuur in twee delen; opstappen aan de achterkant van de school."><%= a.afspraken || '' %></textarea>
          <div><button class="btn ghost small" type="submit">Afspraken opslaan</button></div>
        </div>
      </form>
    </div>

    <div class="card <%= locals.openMeldingen ? 'key' : '' %>">
      <h2 style="font-size:18px;margin-bottom:6px">Meldingen<%= locals.openMeldingen ? ` (${openMeldingen} open)` : '' %></h2>
      <p class="lead" style="font-size:14px;margin:0 0 10px">Elk los eindje met een eigenaar en een deadline: onduidelijke afspraak, planning die anders uitvoert, chauffeur te laat, klacht, creditnota, foutieve invoer in Trip. Zolang er een melding open staat, gaan er geen herinneringen naar de klant en kan de factuur niet naar <%= deurwaarder %>.</p>
      <% (locals.meldingen || []).forEach((m) => { %>
      <div style="border-top:1px solid var(--line);padding:10px 0">
        <div class="between" style="flex-wrap:wrap;gap:6px 12px">
          <strong>M-<%= m.id %> · <%= MELDING_SOORTEN[m.soort] || m.soort %></strong>
          <span class="badge <%= m.status === 'open' ? (new Date(m.deadline) < new Date(new Date().toDateString()) ? 'k-D' : 'k-C') : 'k-A' %>"><%= m.status === 'open' ? `Open, ${MELDING_EIGENAREN[m.eigenaar] || m.eigenaar}, deadline ${datum(m.deadline)}` : `Opgelost ${datumTijd(m.opgelost_op)}` %></span>
        </div>
        <p style="margin:6px 0 0;white-space:pre-wrap"><%= m.omschrijving %></p>
        <p class="lead" style="font-size:13px;margin:4px 0 0">Gemeld <%= datumTijd(m.created_at) %><%= m.gemeld_door ? ` door ${m.gemeld_door}` : '' %>.<%= m.oplossing ? ` Oplossing: ${m.oplossing}` : '' %></p>
        <% if (m.status === 'open') { %>
        <%- form(`melding/${m.id}/oplossen`) %>
          <div class="inline-form" style="margin-top:8px">
            <div><label for="opl<%= m.id %>">Hoe opgelost?</label><input type="text" id="opl<%= m.id %>" name="oplossing" placeholder="Bijv. klant gebeld, excuses, creditnota € 150 gemaakt"></div>
            <button class="btn small ghost" type="submit">Opgelost</button>
          </div>
        </form>
        <% } %>
      </div>
      <% }) %>
      <%- form('melding') %>
        <div style="display:flex;flex-direction:column;gap:8px;border-top:1px solid var(--line);padding-top:12px;margin-top:4px">
          <div class="grid2">
            <div><label for="msoort">Soort</label><select id="msoort" name="soort"><% Object.entries(MELDING_SOORTEN).forEach(([k2, lab]) => { %><option value="<%= k2 %>"><%= lab %></option><% }) %></select></div>
            <div><label for="meigenaar">Eigenaar</label><select id="meigenaar" name="eigenaar"><option value="">Standaard bij deze soort</option><% Object.entries(MELDING_EIGENAREN).forEach(([k2, lab]) => { %><option value="<%= k2 %>"><%= lab %></option><% }) %></select></div>
          </div>
          <div><label for="momschrijving">Wat is er aan de hand?</label><textarea id="momschrijving" name="omschrijving" placeholder="Bijv. klant meldt dat de chauffeur 25 minuten te laat was bij de school; groep miste de eerste activiteit."></textarea></div>
          <div class="inline-form">
            <div><label for="mdeadline">Deadline <span class="opt">(standaard 5 werkdagen)</span></label><input type="date" id="mdeadline" name="deadline"></div>
            <button class="btn ghost" type="submit">Melding aanmaken</button>
          </div>
        </div>
      </form>
    </div>

    <div class="card scroll">
      <h2 style="font-size:18px;margin-bottom:10px">Opbouw van de score</h2>
      <table>
        <thead><tr><th>Factor</th><th>Bron</th><th class="num">Punten</th></tr></thead>
        <tbody>
          <% (a.score_factoren || []).forEach(f => { %>
          <tr><td><%= f.label %></td><td class="lead" style="margin:0"><%= f.bron %></td><td class="num <%= f.punten > 0 && f.label !== 'Startwaarde' ? 'pos' : f.punten < 0 ? 'neg' : '' %>"><%= f.punten > 0 && f.label !== 'Startwaarde' ? '+' : '' %><%= f.punten %></td></tr>
          <% }) %>
          <tr style="font-weight:700"><td>Totaal</td><td></td><td class="num"><%= a.score %></td></tr>
        </tbody>
      </table>
      <p class="lead" style="margin:10px 0 0;font-size:14px">Betaalhistorie: <%= historie.betaaldOpTijd %> op tijd, <%= historie.betaaldTeLaat1tot30 %> 1–30 dagen te laat, <%= historie.ooitTeLaat30Plus %> ruim te laat, <%= historie.incasso %> incasso, <%= historie.open %> open. KvK: <%= k.kvk ? `${k.kvk} (${k.kvk_bron || '-'})` : 'n.v.t.' %><%= k.kvk_opgericht ? `, sinds ${datum(k.kvk_opgericht)}` : '' %>.</p>
    </div>

    <% if (['nieuw','offerte_verstuurd'].includes(a.status)) { %>
    <div class="card">
      <h2 style="font-size:18px">Offerte</h2>
      <p class="lead">Bedragen incl. 9% btw. Een prijswijziging zet de offerte terug naar nieuw; verstuur hem daarna opnieuw.</p>
      <%- form('prijs') %>
        <div class="inline-form">
          <div><label for="ritprijs">Ritprijs</label><input type="text" inputmode="decimal" id="ritprijs" name="ritprijs" value="<%= a.ritprijs_cent != null ? (a.ritprijs_cent/100).toFixed(2).replace('.', ',') : '' %>" placeholder="2400,00"></div>
          <div><label for="nakosten_schatting">Geschatte nakosten <span class="opt">(tol, parkeren)</span></label><input type="text" inputmode="decimal" id="nakosten_schatting" name="nakosten_schatting" value="<%= a.nakosten_schatting_cent ? (a.nakosten_schatting_cent/100).toFixed(2).replace('.', ',') : '' %>" placeholder="0,00"></div>
          <button class="btn ghost" type="submit">Opslaan</button>
        </div>
      </form>
      <% if (a.ritprijs_cent != null && !a.geblokkeerd) { %>
      <div class="row" style="margin-top:14px">
        <%- form('offerte') %><button class="btn" type="submit"><%= a.status === 'offerte_verstuurd' ? 'Offerte opnieuw versturen' : 'Offerte versturen naar opdrachtgever' %></button></form>
      </div>
      <% } %>
      <% if (a.status === 'offerte_verstuurd') { %>
      <p style="margin:14px 0 0;font-size:14px;overflow-wrap:anywhere">Prijs geldig t/m <%= a.offerte_geldig_tot ? datum(a.offerte_geldig_tot) : '-' %> (<%= beleid.geldigDagen %> dagen; opnieuw versturen verlengt). Akkoordlink: <a href="<%= akkoordLink %>"><%= akkoordLink %></a></p>
      <% } %>
    </div>
    <% } %>

    <% if (termijnen.length) { %>
    <div class="card scroll">
      <h2 style="font-size:18px;margin-bottom:10px">Aanbetaling</h2>
      <table>
        <thead><tr><th>Termijn</th><th>Uiterlijk</th><th class="num">Bedrag</th><th>Status</th></tr></thead>
        <tbody><% termijnen.forEach(t => { %>
          <tr>
            <td><%= t.label %></td><td><%= t.uiterlijk ? datum(t.uiterlijk) : 'Bij akkoord' %></td><td class="num"><%= euro(t.bedrag_cent) %></td>
            <td><% if (t.betaald_op) { %><span class="badge k-A">Betaald <%= datumTijd(t.betaald_op) %></span><% } else { %><%- form(`termijn/${t.id}/betaald`) %><button class="btn small ghost" type="submit">Overschrijving ontvangen</button></form><% if (t.herinnering_op) { %><div class="lead" style="font-size:13px;margin:4px 0 0">Herinnerd <%= datumTijd(t.herinnering_op) %></div><% } %><% } %></td>
          </tr>
        <% }) %></tbody>
      </table>
    </div>
    <% } %>

    <% if (['bevestigd','gereden'].includes(a.status) || nakosten.length) { %>
    <div class="card">
      <h2 style="font-size:18px">Rit en nakosten</h2>
      <% if (a.status === 'bevestigd') { %>
        <p class="lead">De rit staat in de planning<%= a.trip_export_op ? ` (geëxporteerd naar trip ${datumTijd(a.trip_export_op)})` : '' %>.</p>
        <%- form('gereden') %><button class="btn" type="submit">Rit is gereden</button></form>
      <% } %>
      <% if (nakosten.length) { %>
      <div class="scroll" style="margin-top:12px"><table><tbody><% nakosten.forEach(n => { %><tr><td><%= n.omschrijving %></td><td class="num"><%= euro(n.bedrag_cent) %></td></tr><% }) %></tbody></table></div>
      <% } %>
      <% if (['bevestigd','gereden'].includes(a.status)) { %>
      <div style="margin-top:14px"><%- form('nakosten') %>
        <div class="inline-form">
          <div><label for="omschrijving">Nakosten</label><select id="omschrijving" name="omschrijving"><option>Tol</option><option>Parkeergeld</option><option>Pont</option><option>Verblijf chauffeur</option><option>Extra kilometers op locatie</option><option>Schoonmaakkosten</option></select></div>
          <div><label for="bedrag">Bedrag incl. btw</label><input type="text" inputmode="decimal" id="bedrag" name="bedrag" placeholder="0,00"></div>
          <button class="btn ghost" type="submit">Toevoegen</button>
        </div>
      </form></div>
      <% } %>
      <% if (a.status === 'gereden') { %>
        <div style="margin-top:14px"><%- form('factuur') %><button class="btn" type="submit">Eindfactuur maken en versturen</button></form></div>
      <% } %>
    </div>
    <% } %>

    <% if (factuur) { %>
    <div class="card">
      <h2 style="font-size:18px;margin-bottom:10px"><%= a.annulering_op ? 'Annuleringsfactuur' : 'Eindfactuur' %> <%= factuur.nummer %></h2>
      <dl class="kv">
        <dt>Totaal</dt><dd><%= euro(factuur.totaal_cent) %></dd>
        <% if (factuur.credit_cent) { %><dt>Creditnota</dt><dd>-<%= euro(factuur.credit_cent) %><%= factuur.credit_reden ? ` (${factuur.credit_reden})` : '' %></dd><% } %>
        <dt>Al betaald</dt><dd><%= euro(factuur.reeds_betaald_cent) %></dd>
        <dt><%= factuur.te_betalen_cent < 0 ? 'Terug te betalen' : 'Te betalen' %></dt><dd><strong><%= euro(Math.abs(factuur.te_betalen_cent)) %></strong></dd>
        <dt>Vervaldatum</dt><dd><%= datum(factuur.vervaldatum) %></dd>
        <dt>Status</dt><dd><%= factuur.betaald_op ? `Betaald op ${datum(factuur.betaald_op)}` : factuur.incasso ? `Bij ${deurwaarder}` : `Open · herinneringsniveau ${factuur.herinnering_niveau} van 4` %></dd>
      </dl>
      <% if (!factuur.betaald_op) { %>
      <div class="row" style="margin-top:14px">
        <%- form('factuur-betaald') %><button class="btn" type="submit">Betaling ontvangen</button></form>
      </div>
      <% } %>
      <% if (!factuur.incasso) { %>
      <div style="border-top:1px solid var(--line);margin-top:16px;padding-top:12px">
        <h3 style="margin-bottom:6px">Creditnota</h3>
        <p class="lead" style="font-size:14px;margin:0 0 8px">Klopt er iets niet (te laat, afwijking, afspraak niet nagekomen)? Crediteer meteen; een creditnota die blijft liggen wordt een onbetaalde factuur. De klant krijgt de creditnota per e-mail.</p>
        <%- form('creditnota') %>
          <div class="inline-form">
            <div><label for="cbedrag">Bedrag incl. btw</label><input type="text" inputmode="decimal" id="cbedrag" name="bedrag" placeholder="150,00"></div>
            <div style="flex:2 1 260px"><label for="creden">Reden</label><input type="text" id="creden" name="reden" placeholder="Bijv. chauffeur 25 minuten te laat, coulance"></div>
            <button class="btn ghost" type="submit">Creditnota maken</button>
          </div>
        </form>
      </div>
      <% } %>
      <% if (overdracht && !factuur.betaald_op && factuur.te_betalen_cent > 0) { %>
      <div style="border-top:1px solid var(--line);margin-top:16px;padding-top:16px">
        <h3 style="margin-bottom:6px">Overdragen aan <%= deurwaarder %></h3>
        <% if (overdracht.mag) { %>
          <p class="lead" style="font-size:15px;margin-bottom:10px"><%= deurwaarder %> krijgt het hele dossier in hun portaal: aanvraag, akkoord, factuur en alle herinneringen. Incassokosten: <%= euro(incassokosten) %> (<%= incassoGrondslag %>)<%= locals.rente && rente.bedrag ? `, rente tot vandaag ${euro(rente.bedrag)} (${rente.omschrijving})` : '' %>.</p>
          <%- form('incasso') %>
            <div style="display:flex;flex-direction:column;gap:8px">
              <div><label for="notitie">Toelichting voor <%= deurwaarder %> <span class="opt">(optioneel)</span></label><textarea id="notitie" name="notitie" placeholder="Bijv. debiteur reageert niet op telefoon"></textarea></div>
              <div><button class="btn danger" type="submit">Overdragen aan <%= deurwaarder %></button></div>
            </div>
          </form>
        <% } else { %>
          <p class="lead" style="font-size:15px;margin:0">Nog niet mogelijk: <%= overdracht.reden %></p>
        <% } %>
      </div>
      <% } %>
    </div>
    <% } %>

    <% if (incassoDossier) { %>
    <div class="card">
      <div class="between" style="flex-wrap:wrap;margin-bottom:10px"><h2 style="font-size:18px">Dossier D-<%= incassoDossier.id %> bij <%= deurwaarder %></h2><span class="badge <%= incassoDossier.status === 'betaald' ? 'k-A' : 'st' %>"><%= DOSSIER_STATUS[incassoDossier.status] %></span></div>
      <dl class="kv">
        <dt>Overgedragen</dt><dd><%= datumTijd(incassoDossier.overgedragen_op) %><%= incassoDossier.geopend_op ? ` · geopend ${datumTijd(incassoDossier.geopend_op)}` : ' · nog niet geopend' %></dd>
        <dt>Hoofdsom</dt><dd><%= euro(incassoDossier.hoofdsom_cent) %> + <%= euro(incassoDossier.incassokosten_cent) %> kosten<%= incassoDossier.rente_cent ? ` + ${euro(incassoDossier.rente_cent)} rente` : '' %></dd>
        <dt>Ontvangen</dt><dd><%= euro(incassoDossier.ontvangen_cent) %></dd>
        <% if (incassoDossier.referentie_deurwaarder) { %><dt>Nr. <%= deurwaarder %></dt><dd><%= incassoDossier.referentie_deurwaarder %></dd><% } %>
      </dl>
      <div class="log" style="margin-top:12px;max-height:280px"><% dossierBerichten.forEach(b => { %><div><b><%= b.van %> · <%= datumTijd(b.created_at) %></b>
<%= b.tekst %></div><% }) %></div>
      <% if (!['betaald','oninbaar','teruggetrokken'].includes(incassoDossier.status)) { %>
      <%- form('dossier-bericht') %>
        <div style="display:flex;flex-direction:column;gap:8px;margin-top:12px">
          <label for="dtekst">Bericht aan <%= deurwaarder %></label>
          <textarea id="dtekst" name="tekst"></textarea>
          <div><button class="btn ghost" type="submit">Versturen</button></div>
        </div>
      </form>
      <%- form('dossier-terugtrekken') %>
        <div class="inline-form" style="margin-top:12px">
          <div><label for="treden">Dossier terugtrekken, reden</label><input type="text" id="treden" name="reden" placeholder="Bijv. alsnog regeling met klant getroffen"></div>
          <button class="btn ghost" type="submit">Terugtrekken</button>
        </div>
      </form>
      <% } %>
    </div>
    <% } %>

    <div class="card">
      <h2 style="font-size:18px;margin-bottom:10px">Logboek en e-mails</h2>
      <div class="log"><% events.forEach(e => { %><div><b><%= datumTijd(e.created_at) %> · <%= e.type %></b>
<%= e.tekst %></div><% }) %></div>
    </div>
  </section>

  <aside class="side">
    <div class="card">
      <h2 style="font-size:18px;margin-bottom:10px">Rollen</h2>
      <dl class="kv">
        <dt>Aanvrager</dt><dd><%= a.aanvrager_naam %><%= a.aanvrager_rol ? `, ${a.aanvrager_rol}` : '' %><br><a href="tel:<%= a.aanvrager_tel %>"><%= a.aanvrager_tel %></a><br><%= a.aanvrager_email %></dd>
        <dt>Opdrachtgever</dt><dd><%= k.naam %><br><span class="lead" style="font-size:14px"><%= KLANTTYPE[k.type] %><%= k.kvk ? ` · KvK ${k.kvk}` : '' %></span></dd>
        <dt>Tekenbevoegde</dt><dd><%= k.tekenbevoegde %><br><%= k.teken_email %></dd>
        <dt>Factuur naar</dt><dd><%= a.factuur_email %><%= a.factuur_adres ? `, ${a.factuur_adres}` : '' %></dd>
        <dt>PO-nummer</dt><dd><%= a.po_nummer || 'Niet opgegeven' %></dd>
        <dt>Reisleider</dt><dd><%= a.reisleider_naam ? `${a.reisleider_naam}, ${a.reisleider_tel || ''}` : '—' %></dd>
      </dl>
      <% if (a.akkoord_op) { %><p class="lead" style="margin:12px 0 0;font-size:14px">Akkoord door <strong><%= a.akkoord_naam %></strong> op <%= datumTijd(a.akkoord_op) %><%= a.akkoord_voorwaarden_versie ? `, met acceptatie van de voorwaarden ${a.akkoord_voorwaarden_versie}` : '' %>.</p><% } %>
      <% if (a.voorwaarden_akkoord_op) { %><p class="lead" style="margin:8px 0 0;font-size:14px">Voorwaarden <%= a.voorwaarden_versie %> ter hand gesteld en geaccepteerd door de aanvrager op <%= datumTijd(a.voorwaarden_akkoord_op) %><%= a.voorwaarden_ip ? ` (IP ${a.voorwaarden_ip})` : '' %>.</p><% } %>
    </div>
    <div class="card">
      <div class="between" style="margin-bottom:10px;flex-wrap:wrap;gap:6px"><h2 style="font-size:18px;margin:0">Rit</h2><a class="btn small ghost" href="/admin/aanvraag/<%= a.id %>/briefing">Chauffeursbriefing</a></div>
      <%- include('../partials/reis-samenvatting', { r: vanAanvraag(a) }) %>
      <% if (a.opmerkingen) { %><dl class="kv" style="margin-top:8px"><dt>Bijzonderheden</dt><dd><%= a.opmerkingen %></dd></dl><% } %>
    </div>
    <div class="card">
      <h2 style="font-size:18px">Klasse aanpassen</h2>
      <p class="lead" style="font-size:14px">Geldt voor de opdrachtgever; de reden blijft in het dossier.<%= k.klasse_override ? ` Nu handmatig ${k.klasse_override}: ${k.override_reden}` : '' %></p>
      <%- form('klasse') %>
        <div style="display:flex;flex-direction:column;gap:10px">
          <div><label for="klasse">Klasse</label><select id="klasse" name="klasse"><option value="auto">Berekend</option><% ['A','B','C','D'].forEach(x => { %><option value="<%= x %>" <%= k.klasse_override === x ? 'selected' : '' %>><%= x %></option><% }) %></select></div>
          <div><label for="reden">Reden</label><input type="text" id="reden" name="reden" placeholder="Bijv. raamcontract uit aanbesteding"></div>
          <button class="btn ghost" type="submit">Opslaan</button>
        </div>
      </form>
    </div>
    <% if (['nieuw','offerte_verstuurd','wacht_op_betaling','bevestigd'].includes(a.status)) { %>
    <div class="card">
      <h2 style="font-size:18px">Annuleren</h2>
      <% if (locals.annulering && annulering.bedenktijd) { %><p class="lead" style="font-size:14px;margin:0 0 10px">Het akkoord is minder dan <%= beleid.uren %> uur oud: annuleren is nu kosteloos (bedenktijd, beleid Pouw).</p><% } else if (locals.annulering) { %><p class="lead" style="font-size:14px;margin:0 0 10px">Opzegging vandaag is <%= annulering.dagen %> dag(en) voor vertrek: <%= annulering.pct %>% van de ritprijs<%= annulering.bedrag === annulering.minimum ? ' (het minimum)' : '' %> = <strong><%= euro(annulering.bedrag) %></strong> volgens artikel 5.1.</p><% } else { %><p class="lead" style="font-size:14px;margin:0 0 10px">Nog geen gesloten overeenkomst: annuleren is zonder kosten.</p><% } %>
      <%- form('annuleren') %>
        <div style="display:flex;flex-direction:column;gap:10px">
          <div><label for="annreden">Reden</label><input type="text" id="annreden" name="reden" placeholder="Bijv. schriftelijke opzegging per e-mail van 12 oktober"></div>
          <% if (locals.annulering && annulering.bedrag > 0) { %><label class="check" for="annkosten"><input type="checkbox" id="annkosten" name="kosten" checked><span>Annuleringskosten in rekening brengen (<%= euro(annulering.bedrag) %>). Er komt een factuur met verrekening van wat al is betaald; de klant krijgt een schriftelijke bevestiging.</span></label><% } %>
          <button class="btn danger" type="submit">Aanvraag annuleren</button>
        </div>
      </form>
    </div>
    <% } %>
  </aside>
  </div>
</main>
<%- include('../partials/foot') %>

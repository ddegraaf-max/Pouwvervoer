<%- include('../partials/head', { titel: `Chauffeursbriefing EPV-${a.id}`, admin: true, kaart: true }) %>
<main class="wrap briefing">
  <div class="between no-print" style="flex-wrap:wrap;gap:10px;margin-bottom:16px">
    <div class="lead" style="margin:0"><a href="/admin/aanvraag/<%= a.id %>">Terug naar het dossier</a></div>
    <button class="btn ghost small" type="button" data-print>Printen</button>
  </div>
  <% if (locals.melding) { %><div class="alert ok no-print" style="margin-bottom:16px"><%= melding %></div><% } %>

  <div class="card no-print" style="margin-bottom:16px">
    <h2 style="font-size:18px;margin-bottom:6px">Digitale briefing en ritrapport voor de chauffeur</h2>
    <p class="lead" style="font-size:14px">De chauffeur opent de rit op zijn telefoon: route, tijden, contact en afspraken, een checklist, en een rapport waarin hij schade, rotzooi, afwijkingen, extra kosten en incidenten met foto's vastlegt. Alles komt direct in dit dossier; schade, rotzooi en extra kosten komen ook op de werklijst van de administratie.</p>
    <form method="post" action="/admin/aanvraag/<%= a.id %>/chauffeur" style="margin:0 0 12px">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="inline-form">
        <div><label for="chauffeur_naam">Chauffeur</label><input type="text" id="chauffeur_naam" name="naam" value="<%= a.chauffeur_naam || '' %>" placeholder="Naam"></div>
        <div><label for="chauffeur_tel">Mobiel</label><input type="tel" id="chauffeur_tel" name="tel" value="<%= a.chauffeur_tel || '' %>" placeholder="06 …"></div>
        <button class="btn<%= ritLink ? ' ghost' : '' %>" type="submit"><%= ritLink ? 'Gegevens opslaan' : 'Link voor de chauffeur maken' %></button>
      </div>
    </form>
    <% if (ritLink) { const wa = (a.chauffeur_tel || '').replace(/[^0-9]/g, '').replace(/^0/, '31'); %>
    <div style="display:flex;gap:18px;flex-wrap:wrap;align-items:flex-start">
      <div class="qr-klein" aria-label="QR-code van de ritlink"><%- qr %></div>
      <div style="flex:1 1 280px;min-width:0">
        <div class="linkvak">
          <input type="text" readonly value="<%= ritLink %>" id="ritlink" aria-label="Ritlink">
          <button class="btn small ghost" type="button" data-kopieer="#ritlink">Kopiëren</button>
          <a class="btn small whatsapp" href="https://wa.me/<%= wa %>?text=<%= encodeURIComponent(`Rit EPV-${a.id} op ${datum(a.rit_datum)} (${k.naam}): ${ritLink}`) %>" target="_blank" rel="noopener">WhatsApp</a>
        </div>
        <p class="lead" style="font-size:13px;margin:8px 0 0">Laat de chauffeur de QR-code scannen of stuur de link. De link is persoonlijk en werkt tot <%= RIT.GELDIG_DAGEN_NA_RIT %> dagen na de rit<%= linkGeldig ? '' : ' (nu niet geldig: de rit is nog niet bevestigd of al te lang geleden)' %>.<% if (a.rit_afgerond_op) { %> Rit afgerond door de chauffeur op <%= datumTijd(a.rit_afgerond_op) %>.<% } else if (a.rit_gestart_op) { %> Geopend door de chauffeur op <%= datumTijd(a.rit_gestart_op) %>.<% } %></p>
        <form method="post" action="/admin/aanvraag/<%= a.id %>/chauffeur" style="margin:8px 0 0">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="naam" value="<%= a.chauffeur_naam || '' %>"><input type="hidden" name="tel" value="<%= a.chauffeur_tel || '' %>"><input type="hidden" name="vernieuw" value="1">
          <button class="btn small ghost" type="submit">Link vernieuwen (de oude vervalt)</button>
        </form>
      </div>
    </div>
    <% } %>
  </div>

  <%- include('../partials/briefing-inhoud', { a, k }) %>

  <div class="cols" style="margin-top:16px">
    <section class="main">
      <div class="card" id="rapport">
        <h2 style="font-size:18px;margin-bottom:8px">Ritrapport van de chauffeur</h2>
        <% if (!rapport.length) { %>
        <p class="lead" style="margin:0"><%= a.chauffeur_token ? 'Nog geen meldingen. De chauffeur legt onderweg vast wat afwijkt; dat verschijnt hier met foto\'s.' : 'Maak eerst de link voor de chauffeur; zijn meldingen en foto\'s verschijnen hier.' %></p>
        <% } else { %>
        <div class="rapport-lijst">
          <% rapport.forEach((m) => { const s = RIT.SOORTEN[m.soort] || RIT.SOORTEN.opmerking; %>
          <div class="item">
            <div class="between" style="flex-wrap:wrap;gap:6px"><span class="badge r-<%= m.soort %>"><%= s.label %></span><span class="lead" style="margin:0;font-size:13px">R-<%= m.id %> · <%= datumTijd(m.created_at) %> · <%= m.door || 'chauffeur' %><%= m.melding_id ? ` · werklijst M-${m.melding_id}` : '' %></span></div>
            <p style="margin:6px 0 0;white-space:pre-wrap"><%= m.omschrijving %></p>
            <% if (m.locatie || m.bedrag_cent != null) { %><p class="lead" style="margin:4px 0 0;font-size:14px"><%= [m.locatie, m.bedrag_cent != null ? euro(m.bedrag_cent) : ''].filter(Boolean).join(' · ') %></p><% } %>
            <% if (m.fotos.length) { %><div class="fotos"><% m.fotos.forEach((f) => { %><a href="/admin/aanvraag/<%= a.id %>/foto/<%= f.id %>" target="_blank" rel="noopener"><img src="/admin/aanvraag/<%= a.id %>/foto/<%= f.id %>" alt="Foto bij R-<%= m.id %>" loading="lazy"></a><% }) %></div><% } %>
          </div>
          <% }) %>
        </div>
        <% } %>
        <% if (a.rit_slot) { %><p style="margin:12px 0 0;white-space:pre-wrap"><strong>Slotopmerking van de chauffeur:</strong> <%= a.rit_slot %></p><% } %>
      </div>
    </section>
    <aside class="side">
      <div class="card">
        <h2 style="font-size:18px;margin-bottom:8px">Checklist</h2>
        <% const c = a.rit_checklist || {}; %>
        <ul class="checklist"><% RIT.CHECKLIST.forEach(([id, tekst]) => { %><li class="<%= c[id] ? 'af' : '' %>"><%= tekst %></li><% }) %></ul>
        <% if (a.rit_gestart_op) { %><p class="lead" style="font-size:13px;margin:8px 0 0">Afgevinkt door de chauffeur op zijn telefoon.</p><% } %>
      </div>
    </aside>
  </div>
</main>
<%- include('../partials/foot') %>
